header.header.bg-white.shadow-sm.py-2
  .container-fluid
    .d-flex.justify-content-between.align-items-center

      // Logo
      .header-left
        a.text-decoration-none.fw-bold.fs-4.text-dark(href="/admin/dashboard")
          i.fa-solid.fa-gauge-high.me-2
          | ADMIN PANEL

      // User Actions
      .header-right
        if(currentUser)
          .d-flex.align-items-center.gap-2
            a.btn.btn-outline-primary.btn-sm(
              href=`${prefixAdmin}/my-account`
            )
              i.fa-solid.fa-user.me-1
              | #{currentUser.fullName}

            a.btn.btn-danger.btn-sm(
              href=`${prefixAdmin}/auth/logout`
            )
              i.fa-solid.fa-right-from-bracket.me-1
              | Đăng xuất
        else
          a.btn.btn-primary.btn-sm(
            href=`${prefixAdmin}/auth/login`
          )
            i.fa-solid.fa-right-to-bracket.me-1
            | Đăng nhập