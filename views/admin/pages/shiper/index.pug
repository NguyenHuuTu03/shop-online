extends ../../layouts/default
include ../../mixins/moment

block main
  .order-container

    //- TOP BAR
    .order-topbar
      .order-title
        span.title-line
        h2 Giao hàng

      .order-actions
        form.search-box(method="GET")
          input(
            type="text"
            name="keyword"
            placeholder="Tìm kiếm theo tên / SĐT..."
          )
          button(type="submit")
            i.fa-solid.fa-magnifying-glass
          
        a.btn-add(href=`${prefixAdmin}/deliver/list`)
          i.fa-solid.fa-list
          span Danh sách đơn hàng

    //- CONTENT
    .order-content

      //- FILTER
      .filter-bar

        select(name="status").form-filter
          option(value="all-all") Tất cả trạng thái
          option(value="status-PENDING") Chờ xác nhận
          option(value="status-CONFIRMED") Đã xác nhận
          option(value="status-SHIPPING") Đang giao
          option(value="status-DELIVERED") Đã giao
          option(value="status-CANCELED") Đã huỷ
          option(value="paymentStatus-PAID") Đã thanh toán
          option(value="paymentStatus-UNPAID") Chưa thanh toán
          option(value="paymentStatus-FAILED") Thanh toán lỗi

        select(name="limit").form-filter-limit
          option(value="10") 10 đơn hàng
          option(value="15") 15 đơn hàng
          option(value="20") 20 đơn hàng

      //- TABLE
      .table-wrapper
        table.order-table

          thead
            tr
              th.col-checkbox
                input(type="checkbox" id="check-all")

              th.col-stt STT
              th Người đặt
              th SĐT
              th Ngày đặt
              th.col-total.text-center Tổng tiền
              th.col-status Trạng thái
              th.col-payment Thanh toán
              th.col-action Hành động

          tbody
            if orders && orders.length > 0
              each order, index in orders
                tr(data-order=order.id)

                  td
                    input(type="checkbox" value=order._id class="check-item")

                  td.text-center #{index + 1}

                  td
                    .order-name #{order.fullName}

                  td
                    .order-phone #{order.phone}

                  td
                    .order-date
                      +momentDate(order.createdAt)

                  td.text-center
                    strong #{order.totalPrice.toLocaleString()}đ

                  //- STATUS ORDER
                  td.col-status
                    if order.status == "PENDING"
                      span.status.status--pending Chờ xác nhận
                    else if order.status == "CONFIRMED"
                      span.status.status--confirmed Đã xác nhận
                    else if order.status == "SHIPPING"
                      span.status.status--shipping Đang giao
                    else if order.status == "COMPLETED"
                      span.status.status--delivered Đã giao
                    else if order.status == "CANCELED"
                      span.status.status--canceled Đã huỷ

                  //- PAYMENT STATUS
                  td.col-payment
                    if order.paymentStatus == "PAID"
                      button.status.status--paid Đã thanh toán
                    else if (order.paymentStatus == "UNPAID" || order.paymentStatus == "PENDING")
                      button.status.status--unpaid Chưa thanh toán
                    else if order.paymentStatus == "FAILED"
                      button.status.status--failed Thanh toán lỗi

                  //- ACTION
                  td.col-action
                    .action-group

                      //- a.action-btn.view(
                      //-   href=`${prefixAdmin}/deliver/detail/${order._id}`
                      //-   title="Chi tiết"
                      //- )
                      //-   i.fa-regular.fa-eye

                      button.action-btn.accept(btn-add-ship=order.id)
                        i.fa-solid.fa-box

                      //- a.action-btn.delete(
                      //-   href=`${prefixAdmin}/orders/delete/${order._id}`
                      //-   title="Xóa"
                      //- )
                      //-   i.fa-regular.fa-trash-can

            else
              tr
                td(colspan="9")
                  .empty-state Không có đơn hàng nào

    //- PAGINATION
    nav.pagination-wrapper
      ul.pagination

        if currentPage > 1
          li.page-item
            a.page-link(href=`?page=${currentPage - 1}`) Previous

        - var startPage = Math.max(1, currentPage - 2)
        - var endPage = Math.min(totalPage, currentPage + 2)

        - for (let i = startPage; i <= endPage; i++)
          li.page-item(class=(currentPage == i ? "active" : ""))
            a.page-link(href=`?page=${i}`) #{i}

        if currentPage < totalPage
          li.page-item
            a.page-link(href=`?page=${currentPage + 1}`) Next

block scripts 
  script(src="/admin/js/ship.js") 