extends ../../layouts/default.pug

block main
  .permission-container
    div(data-role = roles)

    // ================= TOP BAR =================
    .permission-topbar
      .permission-title
        span.title-line
        h2 Phân quyền hệ thống

      .permission-actions
        a.btn-back(href=`${prefixAdmin}/roles`)
          i.fa-solid.fa-arrow-left
          span Danh sách nhóm quyền

        button.btn-save(type="submit" permission-submit)
          i.fa-solid.fa-floppy-disk
          span Lưu phân quyền

    // ================= CONTENT =================
    .permission-content

      #permission-form

        .table-wrapper
          table.permission-table

            thead
              tr
                th Chức năng
                  each role in roles
                    th.text-center #{role.title}

            tbody

              // ================= CATEGORY =================
              tr(data-name="id" class="d-none")
                td
                each role in roles 
                  td.text-center
                    input(type="text" value=role.id)

              tr.section-row
                td(colspan=`${roles.length + 1}`) 
                  i.fa-solid.fa-folder-tree
                  span  Dashboard

              tr(data-name="dashboard_view")
                td Xem
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              tr.section-row
                td(colspan=`${roles.length + 1}`) 
                  i.fa-solid.fa-folder-tree
                  span  Danh mục sản phẩm

              tr(data-name="categories_view")
                td Xem
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )
                

              tr(data-name="categories_create")
                td Thêm
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              tr(data-name="categories_edit")
                td Sửa
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              tr(data-name="categories_delete")
                td Xóa
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )


              // ================= PRODUCT =================
              tr.section-row
                td(colspan=`${roles.length + 1}`)
                  i.fa-solid.fa-box-open
                  span  Sản phẩm

              tr(data-name="products_view")
                td Xem
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              tr(data-name="products_create")
                td Thêm
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              tr(data-name="products_edit")
                td Sửa
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              tr(data-name="products_delete")
                td Xóa
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )


              // ================= ORDER =================
              tr.section-row
                td(colspan=`${roles.length + 1}`) 
                  i.fa-solid.fa-cart-shopping
                  span  Đơn hàng

              tr(data-name="orders_view")
                td Xem
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              tr(data-name="orders_edit")
                td Cập nhật
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              tr(data-name="orders_delete")
                td Xóa
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )


              // ================= ROLE =================
              tr.section-row
                td(colspan=`${roles.length + 1}`) 
                  i.fa-solid.fa-user-shield
                  span  Nhóm quyền

              tr(data-name="roles_view")
                td Xem
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )
              tr(data-name="roles_create")
                td Thêm
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )
                  
              tr(data-name="roles_edit")
                td Sửa
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              tr(data-name="roles_delete")
                td Xoá
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              tr(data-name="roles_permissions")
                td Phân quyền
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )


              // ================= USER =================
              tr.section-row
                td(colspan=`${roles.length + 1}`) 
                  i.fa-solid.fa-users
                  span  Người dùng

              tr(data-name="users_view")
                td Xem
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              tr(data-name="users_create")
                td Thêm
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              tr(data-name="users_edit")
                td Sửa
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              tr(data-name="users_delete")
                td Xóa
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              // ================= Ship =================
              tr.section-row
                td(colspan=`${roles.length + 1}`) 
                  i.fa-solid.fa-motorcycle
                  span  Giao hàng

              tr(data-name="deliver_view")
                td Xem
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              tr(data-name="deliver_add")
                td Nhận
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              tr(data-name="deliver_update")
                td Cập nhật
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )
                    
              // ================= Client View =================
              tr.section-row
                td(colspan=`${roles.length + 1}`) 
                  i.fa-solid.fa-display
                  span  Giao diện người dùng

              tr(data-name="client_view")
                td Xem
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              // ================= Setting =================
              tr.section-row
                td(colspan=`${roles.length + 1}`) 
                  i.fa-solid.fa-gear
                  span  Cài đặt chung

              tr(data-name="general")
                td Cài đặt
                each role in roles
                  td.text-center
                    input.permission-checkbox(type="checkbox" )

              

block scripts 
  script(src="/admin/js/role.js") 