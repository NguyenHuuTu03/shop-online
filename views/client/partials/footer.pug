      .footer__column
        h3 Hỗ trợ khách hàng

        ul
          li
            a(href="#") Chính sách bảo hành

          li
            a(href="#") Chính sách đổi trả

          li
            a(href="#") Chính sách giao hàng

          li
            a(href="#") Hướng dẫn mua hàng

      .footer__column
        h3 Thông tin liên hệ

        .footer__contact
          p
