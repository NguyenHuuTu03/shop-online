        //-   img(src="/client/images/logo.png" alt="Logo")

        p.footer__desc
          | Chuyên cung cấp điện thoại, laptop, phụ kiện điện tử
          | chính hãng với giá tốt nhất thị trường.

        .footer__social
          a(href="#")
