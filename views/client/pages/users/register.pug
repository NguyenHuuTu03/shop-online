extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  .container
    +alertError(3000)
    .row.justify-content-center.align-items-center(style="min-height: 100vh")
      .col-12.col-sm-10.col-md-8.col-lg-6.col-xl-5
        .card.shadow-lg.border-0
          .card-body.p-5

            h3.text-center.mb-4.fw-bold #{pageTitle}

            form(method="POST" action="/users/register")
              

              .mb-3
                label.form-label(for="fullName") Họ tên
                input#email.form-control.form-control-lg(
                  type="fullName"
                  name="fullName"
                  placeholder="Nhập họ tên"
                  required
                )
              .mb-3
                label.form-label(for="email") Email
                input#email.form-control.form-control-lg(
                  type="email"
                  name="email"
                  placeholder="Nhập email"
                  required
                )
              .mb-3
                label.form-label(for="password") Mật khẩu
                input#password.form-control.form-control-lg(
                  type="password"
                  name="password"
                  placeholder="Nhập mật khẩu"
                  required
                )

              .d-grid.mt-4
                button.btn.btn-primary.btn-lg(type="submit") Đăng Ký

            .text-center.mt-4
              a(href="/users/login") Đã có tài khoản? Đăng nhập