extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  .reset-password-page
    .container

      +alertError(3000)
      +alertSuccess(3000)

      .row.justify-content-center.align-items-center(
        style="min-height: 100vh"
      )

        .col-12.col-sm-10.col-md-8.col-lg-6.col-xl-5

          .card.shadow-lg.border-0

            .card-body.p-5

              // ===== HEADER =====
              .text-center.mb-4

                .reset-icon
                  i.fa.fa-key

                h3.fw-bold.mt-3 #{pageTitle}

                p.text-muted.mb-0
                  | Vui lòng nhập mật khẩu mới của bạn

              // ===== FORM =====
              form(method="POST" action="/users/reset-password")

                // ===== NEW PASSWORD =====
                .mb-4

                  label.form-label(for="password")
                    | Mật khẩu mới

                  input#password.form-control.form-control-lg(
                    type="password"
                    name="password"
                    placeholder="Nhập mật khẩu mới"
                    required
                  )

                // ===== CONFIRM PASSWORD =====
                .mb-4

                  label.form-label(for="confirmPassword")
                    | Xác nhận mật khẩu

                  input#confirmPassword.form-control.form-control-lg(
                    type="password"
                    name="confirmPassword"
                    placeholder="Nhập lại mật khẩu"
                    required
                  )

                // ===== BUTTON =====
                .d-grid

                  button.btn.btn-primary.btn-lg(
                    type="submit"
                  )
                    i.fa.fa-save.me-2
                    | Đặt lại mật khẩu

              // ===== BACK LOGIN =====
              .text-center.mt-4

                a.back-login(
                  href="/users/login"
                )
                  i.fa.fa-arrow-left.me-2
                  | Quay lại đăng nhập