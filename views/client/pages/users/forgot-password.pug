extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  .forgot-password-page
    .container

      +alertError(3000)
      +alertSuccess(3000)

      .row.justify-content-center.align-items-center(style="min-height: 100vh")

        .col-12.col-sm-10.col-md-8.col-lg-6.col-xl-5

          .card.shadow-lg.border-0

            .card-body.p-5

              .text-center.mb-4

                .forgot-icon
                  i.fa.fa-lock

                h3.fw-bold.mt-3 Quên mật khẩu

                p.text-muted.mb-0
                  | Nhập email để nhận hướng dẫn đặt lại mật khẩu

              form(method="POST" action="/users/forgot-password")

                // ===== EMAIL =====
                .mb-4
                  label.form-label(for="email")
                    | Email

                  input#email.form-control.form-control-lg(
                    type="email"
                    name="email"
                    placeholder="Nhập email của bạn"
                    required
                  )

                // ===== BUTTON =====
                .d-grid
                  button.btn.btn-primary.btn-lg(type="submit")
                    i.fa.fa-paper-plane.me-2
                    | Gửi yêu cầu

              // ===== BACK LOGIN =====
              .text-center.mt-4
                a.back-login(href="/users/login")
                  i.fa.fa-arrow-left.me-2
                  | Quay lại đăng nhập