extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  .otp-page
    .container

      +alertError(3000)
      +alertSuccess(3000)

      .row.justify-content-center.align-items-center(style="min-height: 100vh")

        .col-12.col-sm-10.col-md-8.col-lg-6.col-xl-5

          .card.shadow-lg.border-0

            .card-body.p-5

              // ===== HEADER =====
              .text-center.mb-4

                .otp-icon
                  i.fa.fa-shield

                h3.fw-bold.mt-3 #{pageTitle}

                p.text-muted.mb-0
                  | Vui lòng nhập mã OTP đã được gửi đến email của bạn

              // ===== FORM =====
              form(method="POST" action="/users/otp-password")

                // ===== OTP =====
                .mb-4
                  label.form-label(for="otp")
                    | Mã OTP

                  input#otp.form-control.form-control-lg.text-center(
                    type="text"
                    name="otp"
                    placeholder="Nhập mã OTP"
                    maxlength="6"
                    required
                  )

                // ===== BUTTON =====
                .d-grid
                  button.btn.btn-primary.btn-lg(type="submit")
                    i.fa.fa-check.me-2
                    | Xác nhận OTP

              // ===== RESEND =====
              .text-center.mt-4

                span.text-muted Không nhận được mã?

                a.resend-link.ms-2(
                  href="/users/forgot-password"
                )
                  | Gửi lại OTP

              // ===== BACK LOGIN =====
              .text-center.mt-3

                a.back-login(
                  href="/users/login"
                )
                  i.fa.fa-arrow-left.me-2
                  | Quay lại đăng nhập  