extends ../../layouts/default.pug
include ../../mixins/filter.pug

block main
  .container.mt-4

    .row

      // ================= LEFT: CATEGORY =================
      .col-lg-3
        +filter("products", slugCategory, brands, query)

            
      // ================= RIGHT: PRODUCT LIST =================
      .col-lg-9

        .d-flex.justify-content-between.align-items-center.mb-3
          h4.mb-0 Sản phẩm
          span.text-muted #{products.length} sản phẩm

        .row
          if(products.length > 0)
            each product in products
              .col-md-4.mb-4
                .card.product-card.h-100

                  // --- ẢNH + BADGE ---
                  a.product-img-wrap(href=`/products/detail/${product.slug}`)
                    img.card-img-top(
                      src=product.thumbnail
                      alt=product.title
                    )
                    if product.featured
                      span.badge-featured Nổi bật
                    if product.discount
                      span.badge-discount -#{product.discount}%

                  // --- NỘI DUNG ---
                  .card-body

                    a.product-title-link(href=`/products/detail/${product.slug}`)
                      h6.card-title #{product.title}

                    .product-price
                      span.price-new #{product.priceNew.toLocaleString()}₫
                      if product.discount
                        span.price-old #{product.price.toLocaleString()}₫

                  // --- NÚT ---
                  .card-footer
                  button.btn-add-cart(
                    btn-cart=product._id
                  )
                    i.fa-solid.fa-cart-shopping
                    | Thêm vào giỏ hàng
          else 
            h5 Không tìm thấy sản phẩm  