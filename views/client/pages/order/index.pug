extends ../../layouts/default

block main
  .checkout-page
    .container.py-5

      .text-center.mb-5
        h2.checkout-page__title Thanh toán đơn hàng
        p.checkout-page__subtitle Hoàn tất thông tin để đặt hàng

      .row.g-4

        // ================= LEFT =================
        .col-lg-7

          .checkout-card

            .checkout-card__header
              h4.mb-0
                i.fa-solid.fa-user.me-2
                | Thông tin nhận hàng

            .checkout-card__body

              form#checkoutForm

                .mb-3
                  label.form-label Họ và tên
                  input.form-control(
                    type="text"
                    name="fullName"
                    placeholder="Nhập họ và tên"
                    required
                  )

                .mb-3
                  label.form-label Số điện thoại
                  input.form-control(
                    type="text"
                    name="phone"
                    placeholder="Nhập số điện thoại"
                    required
                  )

                .mb-3
                  label.form-label Email
                  input.form-control(
                    type="email"
                    name="email"
                    placeholder="Nhập email"

                  )

                .mb-4
                  label.form-label Địa chỉ nhận hàng
                  textarea.form-control(
                    rows="4"
                    name="address"
                    placeholder="Nhập địa chỉ nhận hàng"
                    required
                  )

                h5.mb-3 Phương thức thanh toán

                .payment-methods

                  label.payment-item
                    input(
                      type="radio"
                      name="paymentMethod"
                      value="COD"
                      checked
                    )

                    .payment-item__content
                      .payment-item__left
                        i.fa-solid.fa-money-bill-wave
                        span Thanh toán khi nhận hàng

                      span.badge.text-bg-success Đề xuất

                  label.payment-item
                    input(
                      type="radio"
                      name="paymentMethod"
                      value="MoMo"
                    )

                    .payment-item__content
                      .payment-item__left
                        img(
                          src="data:image/png;base64,"
                          width="24"
                        )
                        span Thanh toán qua MoMo
                  label.payment-item
                    input(
                      type="radio"
                      name="paymentMethod"
                      value="VNPay"
                    )

                    .payment-item__content
                      .payment-item__left
                        img(
                          src="data:image/jpeg;base64,"
                          width="24"
                        )
                        span Thanh toán qua VNPay

                button.btn.btn-primary.btn-lg.w-100.mt-4(id="btnOrder")
                  i.fa-solid.fa-credit-card.me-2
                  | Đặt hàng

        // ================= RIGHT =================
        .col-lg-5

          .checkout-card

            .checkout-card__header
              h4.mb-0
                i.fa-solid.fa-cart-shopping.me-2
                | Đơn hàng của bạn

            .checkout-card__body
              .order-products

              hr
              .summary-total
                span Tổng thanh toán
                span.totalPrice 0 đ
block scripts
  script(src="/client/js/order.js")